{
    "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
    "linter": {
        "enabled": false
    },
    "formatter": {
        "enabled": true,
        "lineWidth": 100,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always",
            "bracketSameLine": false
        }
    },
    "json": {
        "formatter": {
            "trailingCommas": "none"
        }
    },
    "css": {
        "formatter": {
            "enabled": true,
            "quoteStyle": "single",
            "lineWidth": 100
        }
    },
    "html": {
        "formatter": {
            "enabled": true,
            "indentStyle": "space",
            "indentWidth": 4
        }
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!assets/jslib/**",
            "!assets/ruffle/**",
            "!assets/iconfont/**",
            "!node_modules/**"
        ]
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    }
}
